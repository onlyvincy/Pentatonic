# Variabili d'ambiente Supabase per Cloud Sync + Google Login
# Su Vercel puoi anche collegare Supabase direttamente da Storage -> Supabase
# (le variabili NEXT_PUBLIC_SUPABASE_* / SUPABASE_* vengono lette automaticamente).

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
